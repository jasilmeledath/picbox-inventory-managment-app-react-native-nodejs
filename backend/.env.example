# ==========================================
# PICBOX Backend Configuration
# ==========================================

# ----- Server Configuration -----
PORT=8080
NODE_ENV=development

# ----- Database -----
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/picbox?retryWrites=true&w=majority

# ----- JWT Configuration -----
# Generate random strings for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-use-different-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ----- Cloudinary Configuration -----
# Get from: https://cloudinary.com/console
# For local testing, you can use "demo" values
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----- Security -----
# IMPORTANT: Must be exactly 64 hexadecimal characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----- Admin Configuration -----
ADMIN_EMAILS=admin@picbox.com

# ----- Render Configuration (Optional) -----
# Only needed for Render.com deployment
RENDER_SERVICE_NAME=picbox-backend

# ==========================================
# QUICK SETUP FOR LOCAL TESTING:
# ==========================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update MONGO_URI with your MongoDB connection string
#
# 3. Generate ENCRYPTION_KEY:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 4. For Cloudinary (optional for testing):
#    - Use "demo" for all three Cloudinary values for local testing
#    - Or sign up at cloudinary.com for real values
#
# 5. Keep JWT_SECRET and JWT_REFRESH_SECRET as-is for local testing
#    (change them for production!)
#
# 6. Run: npm run seed:company
#
# 7. Start server: npm run dev
# ==========================================
